<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="400.0" minWidth="980.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PatientController">

   <top>
      <Label alignment="CENTER" text="Patient Management" BorderPane.alignment="CENTER">
         <font>
            <Font name="Berlin Sans FB" size="24.0" />
         </font>
         <BorderPane.margin>
            <Insets bottom="10.0" top="15.0" />
         </BorderPane.margin>
      </Label>
   </top>

   <center>
      <VBox spacing="15.0">

         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
         </padding>

         <HBox alignment="CENTER_LEFT" spacing="10.0">

            <Label text="Search:" />

            <TextField fx:id="searchTextField" prefWidth="300.0" promptText="Search by ID, Name or Disease..." />

            <Button fx:id="searchBtn" onAction="#handleSearch" text="Search" />

            <Button fx:id="refreshBtn" onAction="#handleRefresh" text="Refresh" />

         </HBox>

         <TableView fx:id="patientTable" prefHeight="230.0">

            <columns>

               <TableColumn fx:id="idCol" prefWidth="80.0" text="Patient ID" />

               <TableColumn fx:id="nameCol" prefWidth="160.0" text="Name" />

               <TableColumn fx:id="diseaseCol" prefWidth="160.0" text="Disease" />

               <TableColumn fx:id="genderCol" prefWidth="80.0" text="Gender" />

               <TableColumn fx:id="admitStatusCol" prefWidth="120.0" text="Admit Status" />

               <TableColumn fx:id="ageCol" prefWidth="80.0" text="Age" />

            </columns>

         </TableView>

         <GridPane hgap="15.0" vgap="10.0">

            <Label text="Patient ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

            <TextField fx:id="patientIdTextField" editable="false" prefWidth="200.0" promptText="Auto-generated" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Full Name:" GridPane.columnIndex="2" GridPane.rowIndex="0" />

            <TextField fx:id="nameTextField" prefWidth="200.0" promptText="Enter patient name" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label text="Disease / Diagnosis:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

            <TextField fx:id="diseaseTextField" prefWidth="200.0" promptText="e.g. Hypertension" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Gender:" GridPane.columnIndex="2" GridPane.rowIndex="1" />

            <ComboBox fx:id="genderComboBox" prefWidth="200.0" promptText="Select Gender" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label text="Admit Status:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

            <ComboBox fx:id="admitStatusComboBox" prefWidth="200.0" promptText="Select Status" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Age:" GridPane.columnIndex="2" GridPane.rowIndex="2" />

            <TextField fx:id="ageTextField" prefWidth="200.0" promptText="Enter age" GridPane.columnIndex="3" GridPane.rowIndex="2" />

         </GridPane>

         <HBox alignment="CENTER" spacing="15.0">

            <Button fx:id="addBtn" onAction="#handleAdd" prefWidth="110.0" text="Add" />

            <Button fx:id="updateBtn" onAction="#handleUpdate" prefWidth="110.0" text="Update" />

            <Button fx:id="deleteBtn" onAction="#handleDelete" prefWidth="110.0" text="Delete" />

            <Button fx:id="clearBtn" onAction="#handleClear" prefWidth="110.0" text="Clear" />

         </HBox>

      </VBox>
   </center>

   <bottom>
      <HBox spacing="5.0">

         <padding>
            <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
         </padding>

         <Label text="Log:" />
        
         <Label fx:id="patientLog" text="Patient system ready." />

      </HBox>
   </bottom>

</BorderPane>
