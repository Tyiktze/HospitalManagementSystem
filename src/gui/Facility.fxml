<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="400.0"
            minWidth="980.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.FacilityController">

    <top>
        <Label alignment="CENTER"
               text="Facility Management"
               BorderPane.alignment="CENTER">

            <font>
                <Font size="24.0" />
            </font>

            <BorderPane.margin>
                <Insets top="15.0"
                        bottom="10.0" />
            </BorderPane.margin>

        </Label>
    </top>

    <center>
        <VBox spacing="15.0">

            <padding>
                <Insets top="10.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="10.0">

                <Label text="Search:" />

                <TextField fx:id="searchField"
                           prefWidth="300.0"
                           promptText="Facility name" />

                <Button text="Search"
                        onAction="#searchFacilityClicked" />

                <Button text="Display All"
                        onAction="#displayAllClicked" />

            </HBox>

            <TableView fx:id="facilityTable"
                       prefHeight="260.0">

                <columns>

                    <TableColumn fx:id="colFacility"
                                 prefWidth="750.0"
                                 text="Facility" />

                </columns>

            </TableView>

            <GridPane hgap="15.0"
                      vgap="10.0">

                <Label text="Facility:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0" />

                <TextField fx:id="facilityField"
                           prefWidth="300.0"
                           promptText="Facility name"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0" />

            </GridPane>

            <HBox alignment="CENTER"
                  spacing="15.0">

                <Button prefWidth="110.0"
                        text="Add"
                        onAction="#addFacilityClicked" />

                <Button prefWidth="110.0"
                        text="Update"
                        onAction="#updateFacilityClicked" />

                <Button prefWidth="110.0"
                        text="Delete"
                        onAction="#deleteFacilityClicked" />

                <Button prefWidth="110.0"
                        text="Clear"
                        onAction="#clearClicked" />

            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="5.0">

            <padding>
                <Insets top="10.0"
                        right="10.0"
                        bottom="10.0"
                        left="20.0" />
            </padding>

            <Label text="Log:" />

            <Label fx:id="facilityLog"
                   text="Facility system ready." />

        </HBox>
    </bottom>

</BorderPane>