<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="950.0" stylesheets="@../css/application.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DoctorController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0">
         <children>
            <!-- Header Section -->
            <AnchorPane prefHeight="60.0" styleClass="card-header">
               <children>
                  <Label layoutX="14.0" layoutY="16.0" text="Doctor Management" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="20.0" />
                     </font>
                  </Label>
                  <HBox alignment="CENTER_RIGHT" layoutX="450.0" layoutY="13.0" spacing="10.0" AnchorPane.rightAnchor="14.0">
                     <children>
                        <TextField fx:id="searchField" prefHeight="35.0" prefWidth="250.0" promptText="Search by ID or Name..." styleClass="search-input" />
                        <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#handleSearch" prefHeight="35.0" prefWidth="90.0" text="Search">
                           <styleClass>
                              <String fx:value="btn" />
                              <String fx:value="btn-primary" />
                           </styleClass>
                        </Button>
                        <Button fx:id="refreshBtn" mnemonicParsing="false" onAction="#handleRefresh" prefHeight="35.0" prefWidth="90.0" text="Refresh">
                           <styleClass>
                              <String fx:value="btn" />
                              <String fx:value="btn-secondary" />
                           </styleClass>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </AnchorPane>

            <!-- Main Content Area -->
            <HBox spacing="15.0" VBox.vgrow="ALWAYS">
               <children>
                  <!-- Form Card -->
                  <VBox prefWidth="340.0" spacing="12.0" styleClass="card">
                     <children>
                        <Label text="Doctor Details" textFill="#34495e">
                           <font>
                              <Font name="System Bold" size="16.0" />
                           </font>
                        </Label>
                        
                        <VBox spacing="4.0">
                           <children>
                              <Label text="Doctor ID" textFill="#7f8c8d" />
                              <TextField fx:id="doctorIdField" editable="false" prefHeight="35.0" promptText="Auto-generated" styleClass="form-control" />
                           </children>
                        </VBox>

                        <VBox spacing="4.0">
                           <children>
                              <Label text="Full Name *" textFill="#7f8c8d" />
                              <TextField fx:id="nameField" prefHeight="35.0" promptText="Enter full name" styleClass="form-control" />
                           </children>
                        </VBox>

                        <VBox spacing="4.0">
                           <children>
                              <Label text="Specialization *" textFill="#7f8c8d" />
                              <TextField fx:id="specializationField" prefHeight="35.0" promptText="e.g. Cardiology, Neurology" styleClass="form-control" />
                           </children>
                        </VBox>

                        <VBox spacing="4.0">
                           <children>
                              <Label text="Work Timing / Shift *" textFill="#7f8c8d" />
                              <TextField fx:id="timingField" prefHeight="35.0" promptText="e.g. 09:00 - 17:00" styleClass="form-control" />
                           </children>
                        </VBox>

                        <VBox spacing="4.0">
                           <children>
                              <Label text="Qualification *" textFill="#7f8c8d" />
                              <TextField fx:id="qualificationField" prefHeight="35.0" promptText="e.g. MBBS, MD" styleClass="form-control" />
                           </children>
                        </VBox>

                        <VBox spacing="4.0">
                           <children>
                              <Label text="Room Number *" textFill="#7f8c8d" />
                              <TextField fx:id="roomNoField" prefHeight="35.0" promptText="e.g. Room 101" styleClass="form-control" />
                           </children>
                        </VBox>

                        <!-- Action Buttons -->
                        <VBox spacing="8.0">
                           <VBox.margin>
                              <Insets top="10.0" />
                           </VBox.margin>
                           <children>
                              <HBox spacing="10.0">
                                 <children>
                                    <Button fx:id="addBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleAdd" prefHeight="35.0" text="Add" HBox.hgrow="ALWAYS">
                                       <styleClass>
                                          <String fx:value="btn" />
                                          <String fx:value="btn-success" />
                                       </styleClass>
                                    </Button>
                                    <Button fx:id="updateBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleUpdate" prefHeight="35.0" text="Update" HBox.hgrow="ALWAYS">
                                       <styleClass>
                                          <String fx:value="btn" />
                                          <String fx:value="btn-warning" />
                                       </styleClass>
                                    </Button>
                                 </children>
                              </HBox>
                              <HBox spacing="10.0">
                                 <children>
                                    <Button fx:id="deleteBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDelete" prefHeight="35.0" text="Delete" HBox.hgrow="ALWAYS">
                                       <styleClass>
                                          <String fx:value="btn" />
                                          <String fx:value="btn-danger" />
                                       </styleClass>
                                    </Button>
                                    <Button fx:id="clearBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleClear" prefHeight="35.0" text="Clear" HBox.hgrow="ALWAYS">
                                       <styleClass>
                                          <String fx:value="btn" />
                                          <String fx:value="btn-secondary" />
                                       </styleClass>
                                    </Button>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </VBox>

                  <!-- Table Card -->
                  <VBox styleClass="card" HBox.hgrow="ALWAYS">
                     <children>
                        <TableView fx:id="doctorTable" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn fx:id="idCol" prefWidth="80.0" text="Doctor ID" />
                              <TableColumn fx:id="nameCol" prefWidth="130.0" text="Name" />
                              <TableColumn fx:id="specializationCol" prefWidth="120.0" text="Specialization" />
                              <TableColumn fx:id="timingCol" prefWidth="100.0" text="Timing" />
                              <TableColumn fx:id="qualificationCol" prefWidth="100.0" text="Qualification" />
                              <TableColumn fx:id="roomNoCol" prefWidth="75.0" text="Room No" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
