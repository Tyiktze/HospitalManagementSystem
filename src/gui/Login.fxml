<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@../css/application.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
   <children>
      <Label layoutX="14.0" layoutY="14.0" text="UTAR'NT HOSPITAL MANAGEMENT SYSTEM">
         <font>
            <Font size="48.0" />
         </font>
      </Label>
      <Label layoutX="14.0" layoutY="153.0" text="Username:">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="14.0" layoutY="197.0" text="Password:">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TextField fx:id="txtUsername" layoutX="155.0" layoutY="158.0" prefHeight="26.0" prefWidth="362.0" promptText="Enter username" />
      <TextField fx:id="txtPassword" layoutX="155.0" layoutY="201.0" prefHeight="26.0" prefWidth="362.0" promptText="********" />
      <Button styleClass="btn" layoutX="313.0" layoutY="252.0" mnemonicParsing="false" onAction="#btnLoginClicked" text="Login" />
      <Label fx:id="checkMsg" layoutX="368.0" layoutY="256.0" prefHeight="18.0" prefWidth="479.0" />
   </children>
</AnchorPane>
