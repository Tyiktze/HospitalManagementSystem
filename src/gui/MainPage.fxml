<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainPageController">
	<left>
		<fx:include fx:id="sidebar" source="Sidebar.fxml" />
	</left>
   <top>
      <VBox alignment="TOP_CENTER" prefWidth="100.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="HOSPITAL MANAGEMENT SYSTEM">
               <font>
                  <Font name="Calibri" size="36.0" />
               </font>
            </Label>
            <Separator prefWidth="200.0" />
            <Label fx:id="dateLabel" alignment="TOP_RIGHT" maxWidth="Infinity" text="Date|Time">

         <font>
            <Font name="Berlin Sans FB" size="14.0" />
         </font>
         <VBox.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </VBox.margin>

      </Label>
         </children>
      </VBox>
   </top>
   <center>
      <StackPane fx:id="contentArea"/>
   </center>

</BorderPane>
