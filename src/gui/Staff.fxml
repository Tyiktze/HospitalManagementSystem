<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="400.0" minWidth="980.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.StaffController">


    <center>

        <VBox fx:id="mainContent" spacing="20">

            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>


            <!-- Welcome -->
            <VBox fx:id="welcome" managed="false" spacing="10">

                <Label minWidth="-Infinity" text="Welcome to Staff Window!">
                    <font>
                        <Font size="16" />
                    </font>
                </Label>
   
                <Label minWidth="-Infinity" text="Press a button to Start!" />

            </VBox>



            <!-- ADD STAFF -->
            <GridPane fx:id="addStaff" hgap="10" managed="false" vgap="10" visible="false">


                <Label minWidth="-Infinity" text="Staff ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                <TextField fx:id="idField" editable="false" minWidth="-Infinity" text="S000" GridPane.columnIndex="1" GridPane.rowIndex="0" />



                <Label minWidth="-Infinity" text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <TextField fx:id="nameField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />



                <Label minWidth="-Infinity" text="Designation:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

                <TextField fx:id="designationField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />



                <Label minWidth="-Infinity" text="Sex:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
            <ComboBox fx:id="sexField" prefWidth="150.0" promptText="Select Gender" GridPane.columnIndex="1" GridPane.rowIndex="3" />



                <Label minWidth="-Infinity" text="Salary:" GridPane.columnIndex="0" GridPane.rowIndex="4" />

                <TextField fx:id="salaryField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />



                <Button alignment="CENTER" minHeight="25.0" minWidth="-Infinity" onAction="#btnAddStaffClicked" prefWidth="100.0" text="Add Staff" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>


            </GridPane>




            <!-- FIND STAFF -->
            <GridPane fx:id="findStaff" hgap="10" managed="false" vgap="10" visible="false">


                <Label minWidth="-Infinity" text="Staff ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />


                <TextField fx:id="findIdField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />



                <Button alignment="CENTER" minHeight="25.0" minWidth="-Infinity" onAction="#btnFindStaffClicked" prefWidth="100.0" text="Find Staff" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>


            </GridPane>
         <GridPane fx:id="removeStaff" hgap="10" managed="false" vgap="10" visible="false">
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            <children>
               <Label minWidth="-Infinity" text="Staff ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <TextField fx:id="removeIdField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
               <Button alignment="CENTER" minHeight="25.0" minWidth="-Infinity" onAction="#btnRemoveStaffClicked" prefWidth="100.0" text="Find Staff" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <Label minWidth="-Infinity" text="Staff Details:" GridPane.rowIndex="2" />
               <Label fx:id="staffRemoveDetails" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <Button fx:id="btnConfirmRemoveStaff" alignment="CENTER" maxWidth="1.7976931348623157E308" minHeight="25.0" minWidth="-Infinity" onAction="#btnConfirmRemoveStaffClicked" prefWidth="100.0" text="CONFIRM" visible="false" GridPane.columnSpan="2" GridPane.rowIndex="3" />
            </children>
         </GridPane>
         <GridPane fx:id="updateStaff" hgap="10" managed="false" vgap="10" visible="false">
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
			   <RowConstraints />
			   <RowConstraints />
			   <RowConstraints />
			   <RowConstraints />
			   <RowConstraints />
			</rowConstraints>
            <children>
               <Label minWidth="-Infinity" text="Staff ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <TextField fx:id="updateIdField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
               <Button alignment="CENTER" minHeight="25.0" minWidth="-Infinity" onAction="#btnUpdateStaffClicked" prefWidth="100.0" text="Find Staff" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <Label minWidth="-Infinity" text="Staff Details:" GridPane.rowIndex="2" />
               <Label fx:id="staffUpdateDetails" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <GridPane fx:id="updateStaffInner" hgap="10" vgap="10" visible="false" GridPane.columnSpan="2" GridPane.rowIndex="3">
                  <columnConstraints>
                     <ColumnConstraints />
                     <ColumnConstraints />
                  </columnConstraints>
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
                  <children>
                     <Label minWidth="-Infinity" text="New Name:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                     <TextField fx:id="updateNameField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                     <Label minWidth="-Infinity" text="New Designation:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                     <TextField fx:id="updateDesignationField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                     <Label minWidth="-Infinity" text="New Sex:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                     <ComboBox fx:id="updateSexField" prefWidth="150.0" promptText="Select Gender" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                     <Label minWidth="-Infinity" text="New Salary:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                     <TextField fx:id="updateSalaryField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                     <Button alignment="CENTER" maxWidth="1.7976931348623157E308" minHeight="25.0" minWidth="-Infinity" onAction="#btnConfirmUpdateStaffClicked" prefWidth="100.0" text="CONFIRM" GridPane.columnSpan="2" GridPane.rowIndex="4" />
                  </children>
               </GridPane>
            </children>
         </GridPane>
         <GridPane fx:id="searchStaff" hgap="10" managed="false" vgap="10" visible="false">
            <children>
               <Label minWidth="-Infinity" text="Staff ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
               <TextField fx:id="searchIdField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="0" />
               <Label minWidth="-Infinity" text="Name:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
               <TextField fx:id="searchNameField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <Label minWidth="-Infinity" text="Designation:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
               <TextField fx:id="searchDesignationField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <Label minWidth="-Infinity" text="Sex:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
               <ComboBox fx:id="searchSexField" prefWidth="150.0" promptText="Select Gender" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               <Label minWidth="-Infinity" text="Salary:" GridPane.columnIndex="0" GridPane.rowIndex="4" />
               <TextField fx:id="searchSalaryField" minWidth="-Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               <Button alignment="CENTER" minHeight="25.0" minWidth="-Infinity" onAction="#btnSearchStaffClicked" prefWidth="150.0" text="Search Staff" GridPane.columnIndex="1" GridPane.rowIndex="5" />
               <Label minWidth="-Infinity" text="* Only enter known fields" GridPane.rowIndex="5" />
            </children>
            <columnConstraints>
               <ColumnConstraints />
               <ColumnConstraints />
            </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
         </GridPane>





            <!-- DISPLAY TABLE -->
            <VBox fx:id="displayStaff" managed="false" visible="false">


                <TableView fx:id="staffTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minWidth="-Infinity">


                    <columns>


                        <TableColumn fx:id="colId" prefWidth="80" text="ID" />


                        <TableColumn fx:id="colName" prefWidth="200" text="Name" />


                        <TableColumn fx:id="colDesignation" prefWidth="200" text="Designation" />


                        <TableColumn fx:id="colSex" prefWidth="80" text="Sex" />


                        <TableColumn fx:id="colSalary" prefWidth="100" text="Salary" />


                    </columns>


                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>


                </TableView>


            </VBox>


        </VBox>


    </center>





    <!-- TITLE -->
    <top>

        <Label alignment="CENTER" text="Staff" BorderPane.alignment="CENTER">

            <font>
                <Font name="Berlin Sans FB" size="24" />
            </font>

            <BorderPane.margin>
                <Insets bottom="10" top="10" />
            </BorderPane.margin>

        </Label>

    </top>





    <!-- BUTTON MENU -->
    <left>

        <VBox alignment="TOP_CENTER" prefWidth="150" spacing="10">


            <Button alignment="CENTER" minHeight="25.0" onAction="#addStaffClicked" prefWidth="140" text="Add Staff" />


            <Button alignment="CENTER" minHeight="25.0" onAction="#removeStaffClicked" prefWidth="140" text="Remove Staff" />


            <Button alignment="CENTER" minHeight="25.0" onAction="#updateStaffClicked" prefWidth="140" text="Update Staff" />


            <Button alignment="CENTER" minHeight="25.0" onAction="#findStaffClicked" prefWidth="140" text="Find Staff" />


            <Button alignment="CENTER" minHeight="25.0" onAction="#searchStaffClicked" prefWidth="140" text="Search Staff" />


            <Button alignment="CENTER" minHeight="25.0" onAction="#displayAllStaffClicked" prefWidth="140" text="Display All Staff" />


        </VBox>

    </left>
   <bottom>
      <HBox spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Log:" />
            <Label fx:id="staffLog" maxWidth="1.7976931348623157E308" text="Any staff logs will be outputted here!" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </bottom>


</BorderPane>
