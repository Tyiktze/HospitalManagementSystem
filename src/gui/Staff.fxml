<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="400.0"
            minWidth="980.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.StaffController">

    <top>
        <Label alignment="CENTER"
               text="Staff Management"
               BorderPane.alignment="CENTER">
            <font>
                <Font name="Berlin Sans FB" size="24.0" />
            </font>
            <BorderPane.margin>
                <Insets top="15.0" bottom="10.0" />
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <VBox spacing="15.0">

            <padding>
                <Insets top="10.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0" />
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="10.0">

                <Label text="Search:" />

                <TextField fx:id="searchField"
                           prefWidth="300.0"
                           promptText="KEY:VALUE, ... or VALUE" />

                <Button text="Search"
                        onAction="#searchStaffClicked" />

                <Button text="Display All"
                        onAction="#displayAllStaffClicked" />

            </HBox>

            <TableView fx:id="staffTable"
                       prefHeight="230.0">

                <columns>

                    <TableColumn fx:id="colId"
                                 prefWidth="80.0"
                                 text="ID" />

                    <TableColumn fx:id="colName"
                                 prefWidth="200.0"
                                 text="Name" />

                    <TableColumn fx:id="colDesignation"
                                 prefWidth="200.0"
                                 text="Designation" />

                    <TableColumn fx:id="colSex"
                                 prefWidth="80.0"
                                 text="Sex" />

                    <TableColumn fx:id="colSalary"
                                 prefWidth="100.0"
                                 text="Salary" />

                </columns>

            </TableView>

            <GridPane hgap="15.0"
                      vgap="10.0">

                <Label text="Staff ID:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0" />

                <TextField fx:id="idField"
                           prefWidth="200.0"
                           editable="false"
                           promptText="Auto-generated"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0" />

                <Label text="Name:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="0" />

                <TextField fx:id="nameField"
                           prefWidth="200.0"
                           promptText="Full name"
                           GridPane.columnIndex="3"
                           GridPane.rowIndex="0" />

                <Label text="Designation:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1" />

                <TextField fx:id="designationField"
                           prefWidth="200.0"
                           promptText="Job title"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1" />

                <Label text="Sex:"
                       GridPane.columnIndex="2"
                       GridPane.rowIndex="1" />

                <ComboBox fx:id="sexField"
                          prefWidth="200.0"
                          promptText="Select Gender"
                          GridPane.columnIndex="3"
                          GridPane.rowIndex="1" />

                <Label text="Salary:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2" />

                <TextField fx:id="salaryField"
                           prefWidth="200.0"
                           promptText="Salary amount"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2" />

            </GridPane>

            <HBox alignment="CENTER"
                  spacing="15.0">

                <Button prefWidth="110.0"
                        text="Add"
                        onAction="#addStaffClicked" />

                <Button prefWidth="110.0"
                        text="Update"
                        onAction="#updateStaffClicked" />

                <Button prefWidth="110.0"
                        text="Remove"
                        onAction="#removeStaffClicked" />

                <Button prefWidth="110.0"
                        text="Clear"
                        onAction="#clearClicked" />

            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox spacing="5.0">

            <padding>
                <Insets top="10.0"
                        right="10.0"
                        bottom="10.0"
                        left="20.0" />
            </padding>

            <Label text="Log:" />

            <Label fx:id="staffLog"
                   text="Staff system ready." />

        </HBox>
    </bottom>

</BorderPane>
