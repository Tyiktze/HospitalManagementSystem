<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.StaffController">
   <center>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <Label text="Welcome to Staff Window!">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Label>
            <Label text="Press a button to Start!" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
   <top>
      <Label alignment="CENTER" contentDisplay="CENTER" text="Staff" textAlignment="CENTER" BorderPane.alignment="CENTER">
         <font>
            <Font name="Berlin Sans FB" size="24.0" />
         </font>
         <BorderPane.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <left>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="150.0" BorderPane.alignment="TOP_CENTER">
         <children>
            <Button alignment="CENTER" contentDisplay="CENTER" minHeight="25.0" mnemonicParsing="false" onAction="#addStaffClicked" prefHeight="30.0" prefWidth="140.0" text="Add Staff" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </Button>
            <Button alignment="CENTER" contentDisplay="CENTER" minHeight="25.0" mnemonicParsing="false" onAction="#removeStaffClicked" prefHeight="30.0" prefWidth="140.0" text="Remove Staff" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </Button>
            <Button alignment="CENTER" contentDisplay="CENTER" minHeight="25.0" mnemonicParsing="false" onAction="#updateStaffClicked" prefHeight="30.0" prefWidth="140.0" text="Update Staff" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </Button>
            <Button alignment="CENTER" contentDisplay="CENTER" minHeight="25.0" mnemonicParsing="false" onAction="#findStaffClicked" prefHeight="30.0" prefWidth="140.0" text="Find Staff" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </Button>
            <Button alignment="CENTER" contentDisplay="CENTER" minHeight="25.0" mnemonicParsing="false" onAction="#searchStaffClicked" prefHeight="30.0" prefWidth="140.0" text="Search Staff" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </Button>
            <Button alignment="CENTER" contentDisplay="CENTER" minHeight="25.0" mnemonicParsing="false" onAction="#displayAllStaffClicked" prefHeight="30.0" prefWidth="140.0" text="Display All Staff" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </padding>
            </Button>
         </children>
         <padding>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </padding>
      </VBox>
   </left>
</BorderPane>
