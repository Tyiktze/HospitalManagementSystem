<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane minHeight="400.0" minWidth="980.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DoctorController">

   <top>
      <Label alignment="CENTER" text="Doctor Management" BorderPane.alignment="CENTER">
         <font>
            <Font name="Berlin Sans FB" size="24.0" />
         </font>
         <BorderPane.margin>
            <Insets bottom="10.0" top="15.0" />
         </BorderPane.margin>
      </Label>
   </top>

   <center>
      <VBox spacing="15.0">

         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
         </padding>

         <HBox alignment="CENTER_LEFT" spacing="10.0">

            <Label text="Search:" />

            <TextField fx:id="searchTextField" prefWidth="300.0" promptText="Search by ID or Name..." />

            <Button fx:id="searchBtn" onAction="#handleSearch" text="Search" />

            <Button fx:id="refreshBtn" onAction="#handleRefresh" text="Refresh" />

         </HBox>

         <TableView fx:id="doctorTable" prefHeight="230.0">

            <columns>

               <TableColumn fx:id="idCol" prefWidth="80.0" text="Doctor ID" />

               <TableColumn fx:id="nameCol" prefWidth="150.0" text="Name" />

               <TableColumn fx:id="specialistCol" prefWidth="150.0" text="Specialization" />

               <TableColumn fx:id="timingCol" prefWidth="120.0" text="Timing" />

               <TableColumn fx:id="qualificationCol" prefWidth="120.0" text="Qualification" />

               <TableColumn fx:id="roomCol" prefWidth="80.0" text="Room No" />

            </columns>

         </TableView>

         <GridPane hgap="15.0" vgap="10.0">

            <Label text="Doctor ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />

            <TextField fx:id="idField" editable="false" prefWidth="200.0" promptText="Auto-generated" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Full Name:" GridPane.columnIndex="2" GridPane.rowIndex="0" />

            <TextField fx:id="nameField" prefWidth="200.0" promptText="Enter full name" GridPane.columnIndex="3" GridPane.rowIndex="0" />

            <Label text="Specialization:" GridPane.columnIndex="0" GridPane.rowIndex="1" />

            <TextField fx:id="specialistField" prefWidth="200.0" promptText="e.g. Cardiology" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Timing:" GridPane.columnIndex="2" GridPane.rowIndex="1" />

            <TextField fx:id="timingField" prefWidth="200.0" promptText="e.g. 09:00 - 17:00" GridPane.columnIndex="3" GridPane.rowIndex="1" />

            <Label text="Qualification:" GridPane.columnIndex="0" GridPane.rowIndex="2" />

            <TextField fx:id="qualificationField" prefWidth="200.0" promptText="e.g. MBBS, MD" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label text="Room Number:" GridPane.columnIndex="2" GridPane.rowIndex="2" />

            <TextField fx:id="roomField" prefWidth="200.0" promptText="e.g. Room 101" GridPane.columnIndex="3" GridPane.rowIndex="2" />

         </GridPane>

         <HBox alignment="CENTER" spacing="15.0">

            <Button fx:id="addBtn" onAction="#handleAdd" prefWidth="110.0" text="Add" />

            <Button fx:id="updateBtn" onAction="#handleUpdate" prefWidth="110.0" text="Update" />

            <Button fx:id="deleteBtn" onAction="#handleDelete" prefWidth="110.0" text="Delete" />

            <Button fx:id="clearBtn" onAction="#handleClear" prefWidth="110.0" text="Clear" />

         </HBox>

      </VBox>
   </center>

   <bottom>
      <HBox spacing="5.0">

         <padding>
            <Insets bottom="10.0" left="20.0" right="10.0" top="10.0" />
         </padding>

         <Label text="Log:" />
        
         <Label fx:id="doctorLog" text="Doctor system ready." />

      </HBox>
   </bottom>

</BorderPane>
