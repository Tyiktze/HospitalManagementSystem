<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="400.0" prefWidth="220.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.SidebarController">
   <children>
      <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="18.0" prefWidth="201.0" text="HOSPITAL MANAGEMENT SYSTEM" />
      <Separator prefWidth="200.0" />
      <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#dashboardClicked" prefWidth="220.0" text="Dashboard">
         <VBox.margin>
            <Insets bottom="20.0" top="20.0" />
         </VBox.margin>
         <padding>
            <Insets bottom="5.0" left="10.0" top="5.0" />
         </padding>
      </Button>
      <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#doctorsClicked" prefWidth="220.0" text="Doctors">
         <padding>
            <Insets bottom="5.0" left="10.0" top="5.0" />
         </padding>
         <VBox.margin>
            <Insets bottom="5.0" top="5.0" />
         </VBox.margin>
      </Button>
      <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#patientsClicked" prefWidth="220.0" text="Patients">
         <padding>
            <Insets bottom="5.0" left="10.0" top="5.0" />
         </padding>
         <VBox.margin>
            <Insets bottom="5.0" top="5.0" />
         </VBox.margin>
      </Button>
      <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#medicalClicked" prefWidth="220.0" text="Medical">
         <padding>
            <Insets bottom="5.0" left="10.0" top="5.0" />
         </padding>
         <VBox.margin>
            <Insets bottom="5.0" top="5.0" />
         </VBox.margin>
      </Button>
      <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#laboratoriesClicked" prefWidth="220.0" text="Laboratories">
         <padding>
            <Insets bottom="5.0" left="10.0" top="5.0" />
         </padding>
         <VBox.margin>
            <Insets bottom="5.0" top="5.0" />
         </VBox.margin>
      </Button>
      <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#facilitiesClicked" prefWidth="220.0" text="Facilities">
         <padding>
            <Insets bottom="5.0" left="10.0" top="5.0" />
         </padding>
         <VBox.margin>
            <Insets bottom="5.0" top="5.0" />
         </VBox.margin>
      </Button>
      <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#staffClicked" prefWidth="220.0" text="Staff">
         <padding>
            <Insets bottom="5.0" left="10.0" top="5.0" />
         </padding>
         <VBox.margin>
            <Insets bottom="5.0" top="5.0" />
         </VBox.margin>
      </Button>
      <Separator prefWidth="200.0">
         <VBox.margin>
            <Insets bottom="20.0" top="20.0" />
         </VBox.margin>
      </Separator>
      <Button alignment="TOP_LEFT" mnemonicParsing="false" onAction="#exitClicked" prefWidth="220.0" text="Exit">
         <padding>
            <Insets bottom="5.0" left="10.0" top="5.0" />
         </padding>
      </Button>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
